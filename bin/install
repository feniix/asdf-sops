#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$current_script_path")")

# shellcheck source=lib/utils.bash
source "${plugin_dir}/lib/utils.bash"

[ "${ASDF_INSTALL_TYPE:-}" = "version" ] ||
  fail "only release-version installs are supported"
[ -n "${ASDF_INSTALL_VERSION:-}" ] || fail "ASDF_INSTALL_VERSION is required"
[ -n "${ASDF_INSTALL_PATH:-}" ] || fail "ASDF_INSTALL_PATH is required"

download_path=${ASDF_DOWNLOAD_PATH:-}
temp_dir=""
if [ -z "$download_path" ]; then
  temp_dir=$(mktemp -d "${TMPDIR:-/tmp}/asdf-sops.XXXXXX")
  download_path=$temp_dir
  ASDF_DOWNLOAD_PATH=$download_path "${plugin_dir}/bin/download"
fi
trap 'if [ -n "$temp_dir" ]; then rm -rf "$temp_dir"; fi' EXIT

install_path="${ASDF_INSTALL_PATH%/}/bin"
mkdir -p "$install_path"
cp "$download_path/sops" "$install_path/sops"
chmod +x "$install_path/sops"
test -x "$install_path/sops" || fail "expected $install_path/sops to be executable"

echo "SOPS ${ASDF_INSTALL_VERSION} installation was successful"
